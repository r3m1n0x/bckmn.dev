#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
version="$(cat "$project_root/.hugo-version")"
case "$(uname -s)/$(uname -m)" in
  Linux/x86_64) platform=linux-amd64 ;;
  Linux/aarch64|Linux/arm64) platform=linux-arm64 ;;
  Darwin/*) platform=darwin-universal ;;
  *) printf 'Install Hugo %s manually for this platform.\n' "$version" >&2; exit 1 ;;
esac
download_dir="$(mktemp -d)"
trap 'rm -rf -- "$download_dir"' EXIT
archive="hugo_${version}_${platform}.tar.gz"
release="https://github.com/gohugoio/hugo/releases/download/v${version}"
curl --fail --location --silent --show-error "$release/$archive" -o "$download_dir/$archive"
curl --fail --location --silent --show-error "$release/hugo_${version}_checksums.txt" -o "$download_dir/checksums.txt"
expected="$(awk -v filename="$archive" '$2 == filename {print $1}' "$download_dir/checksums.txt")"
if command -v sha256sum >/dev/null; then
  actual="$(sha256sum "$download_dir/$archive" | awk '{print $1}')"
else
  actual="$(shasum -a 256 "$download_dir/$archive" | awk '{print $1}')"
fi
[[ -n "$expected" && "$actual" == "$expected" ]] || { printf 'Hugo checksum verification failed.\n' >&2; exit 1; }
tar -xzf "$download_dir/$archive" -C "$download_dir" hugo
mkdir -p "$project_root/.tools"
install -m 755 "$download_dir/hugo" "$project_root/.tools/hugo"
"$project_root/.tools/hugo" version
